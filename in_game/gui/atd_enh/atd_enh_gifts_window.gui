# [ATD-ENH] Giftable Countries window.
# External contribution (azimali322). Registered in
# gui/scripted_widgets/atd_enh_scripted_widgets.txt so it instantiates.
# Visibility binds to the country variable atd_enh_gifts_window_open, toggled by
# the CMF action-bar button / the alert, and cleared by the close button.
#
# Lists every dominant country of a primary culture currently giftable (off the
# 10-year per-target gift cooldown, still owing less than the gift cap). The
# datamodel is the tracking list itself (atd_enh_giftable_list), whose entries
# are country scopes, so rows render Scope.Country directly. Clicking a row
# opens that country's diplomacy view via OpenDiplomacy.
#
# LAYOUT NOTE (learned the hard way): the scrollarea must NOT live inside the
# header vbox. A vbox auto-arranges its children, and a scrollarea carrying
# percentage sizing + autoresizescrollarea/autoresizeviewport fights that - the
# result was a blank window whose title rendered outside its own frame. Each
# block is therefore its own absolutely-positioned widget, a direct child of the
# window, with explicit pixel sizes. parentanchor/position are only legal on
# direct children for the same reason.
window = {
	name = "atd_enh_gifts_window"
	movable = yes
	resizable = no
	parentanchor = center
	widgetanchor = center
	size = { 460 580 }
	using = bg_window_default_alt
	visible = "[Player.MakeScope.GetVariable('atd_enh_gifts_window_open').IsSet]"

	# Header: title + explanation.
	widget = {
		position = { 20 16 }
		size = { 420 150 }

		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 6

			text_single = {
				fontsize = 18
				text = "atd_enh_gifts_window_title"
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 410
				text = "atd_enh_gifts_window_help"
			}
		}
	}

	# Empty state, shown in place of the list.
	widget = {
		visible = "[Not(DataModelHasItems(Player.MakeScope.GetList('atd_enh_giftable_list')))]"
		position = { 20 180 }
		size = { 420 120 }

		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 410
			text = "atd_enh_gifts_window_empty"
		}
	}

	# Scrolling list of clickable countries. Fixed viewport: content taller than
	# this scrolls rather than overflowing the window.
	widget = {
		visible = "[DataModelHasItems(Player.MakeScope.GetList('atd_enh_giftable_list'))]"
		position = { 20 180 }
		size = { 420 380 }

		scrollarea = {
			size = { 420 380 }
			maximumsize = { 420 380 }
			scrollbarpolicy_horizontal = always_off

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2

					datamodel = "[Player.MakeScope.GetList('atd_enh_giftable_list')]"

					item = {
						button_regular = {
							size = { 390 30 }
							# Opens this country's diplomacy view. The Economy
							# filter still has to be picked there - OpenDiplomacy
							# takes only a country, with no category argument.
							onclick = "[OpenDiplomacy(Scope.Country.Self)]"
							tooltip = "atd_enh_gifts_window_row_tt"
							text = "[Scope.Country.GetName]"
						}
					}
				}
			}

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}
		}
	}

	widget = {
		parentanchor = right
		position = { -8 8 }
		size = { 40 40 }

		button_close_alt = {
			blockoverride "close_on_action" {
				on_action = "[GetScriptedGui('atd_enh_close_gifts_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}
}

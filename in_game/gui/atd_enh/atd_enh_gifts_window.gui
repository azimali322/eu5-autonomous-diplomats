# [ATD-ENH] Giftable Countries window.
# External contribution (azimali322). Registered in
# gui/scripted_widgets/atd_enh_scripted_widgets.txt so it instantiates.
# Visibility binds to the country variable atd_enh_gifts_window_open, toggled by
# the CMF action-bar button / the alert, and cleared by the close button.
#
# Lists every dominant country of a primary culture currently giftable (off the
# 10-year per-target gift cooldown, still owing less than the Send Gifts Up To
# cap). The datamodel is the tracking list itself (atd_enh_giftable_list), whose
# entries are country scopes, so rows render Scope.Country directly. Clicking a
# row opens that country's diplomacy view via OpenDiplomacy.
#
# The scrollarea MUST carry both a fixed size and maximumsize - with only
# layoutpolicy_vertical = expanding it grows to fit every row and runs off the
# bottom of the screen instead of scrolling. The explicit scrollbar_vertical is
# required for the bar to appear.
#
# The close button uses blockoverride "close_on_action" (not onclick), and lives
# in a widget that is a DIRECT child of the window: parentanchor is not allowed
# on children of an hbox/vbox, which auto-arrange.
window = {
	name = "atd_enh_gifts_window"
	movable = yes
	resizable = no
	parentanchor = center
	widgetanchor = center
	size = { 440 520 }
	using = bg_window_default_alt
	visible = "[Player.MakeScope.GetVariable('atd_enh_gifts_window_open').IsSet]"

	vbox = {
		using = window_margin_alt
		spacing = 6
		layoutpolicy_horizontal = expanding

		text_single = {
			fontsize = 18
			text = "atd_enh_gifts_window_title"
		}

		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 390
			text = "atd_enh_gifts_window_help"
		}

		# Empty state.
		text_multi = {
			visible = "[Not(DataModelHasItems(Player.MakeScope.GetList('atd_enh_giftable_list')))]"
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 390
			text = "atd_enh_gifts_window_empty"
		}

		# Scrolling list of clickable countries.
		scrollarea = {
			size = { 100% 360 }
			maximumsize = { -1 360 }
			autoresizescrollarea = yes
			autoresizeviewport = yes
			alwaystransparent = yes
			scrollbarpolicy_horizontal = always_off

			scrollwidget = {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					datamodel = "[Player.MakeScope.GetList('atd_enh_giftable_list')]"

					item = {
						button_regular = {
							layoutpolicy_horizontal = expanding
							minimumsize = { 0 30 }
							# Opens this country's diplomacy view. The Economy
							# filter still has to be picked there - OpenDiplomacy
							# takes only a country, with no category argument.
							onclick = "[OpenDiplomacy(Scope.Country.Self)]"
							tooltip = "atd_enh_gifts_window_row_tt"

							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 8 2 }
								spacing = 6

								text_single = {
									text = "[Scope.Country.GetName]"
								}
								expand = {}
							}
						}
					}
				}
			}

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}
		}
	}

	widget = {
		parentanchor = right
		position = { -8 8 }
		size = { 40 40 }

		button_close_alt = {
			blockoverride "close_on_action" {
				on_action = "[GetScriptedGui('atd_enh_close_gifts_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}
}
